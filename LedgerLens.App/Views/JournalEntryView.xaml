<UserControl x:Class="LedgerLens.App.Views.JournalEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LedgerLens.App.Views"
             mc:Ignorable="d" 
             Background="#F0F2F6"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- JOURNAL HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="Journal Entry"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,20"/>

            <!-- DISCO - Journal Transaction Panel -->
            <Border Background="#E4EAF2"
                Padding="18"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12">

                <Grid>
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DATE -->
                <!-- DATE LABEL -->
                <!-- DATE LABEL -->
                    <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Date"
                       Foreground="#183153"/>

                    <!-- DATE INPUT -->
                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         Height="32"
                         Margin="0,5,10,0"
                         FontSize="16"
                         Text="{Binding DateInput,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>
                <!-- REFERENCE LABEL -->
                    <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="Reference"
                           Foreground="#183153"/>

                    <!-- REFERENCE INPUT -->
                <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Height="32"
                     Margin="0,5,10,0"
                     FontSize="16"
                     Text="{Binding RefInput,
                                    Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- NARRATION -->
                <!-- NARRATION LABEL -->
                    <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Narration"
                       Foreground="#183153"/>
                    <!-- NARRATION LABEL -->
    

                <!-- NARRATION INPUT -->
                <TextBox Grid.Row="1"
                     Grid.Column="2"
                     Height="32"
                     Margin="0,5,10,0"
                     FontSize="16"
                     Text="{Binding NarrationInput,
                                    Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- SAVE BUTTON -->
                <Button Grid.Row="1"
                    Grid.Column="3"
                    Content="SAVE"
                    Height="32"
                    Margin="10,5,0,0"
                    FontWeight="Bold"
                    IsEnabled="{Binding IsSaveEnabled}"
                    Click="SaveJournal_Click"/>
                </Grid>
            </Border>


        </StackPanel>

        <DataGrid Grid.Row="1"
                      x:Name="JournalGrid"
                      PreviewKeyDown="JournalGrid_PreviewKeyDown"
                      ItemsSource="{Binding JournalLines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionUnit="Cell"
                      RowHeight="36"
                      FontSize="14"
                      FontFamily="Segoe UI"
                      HeadersVisibility="Column"
                      Background="#E4EAF2"
                      RowBackground="#E4EAF2"
                      AlternatingRowBackground="#EDF1F6"
                      AlternationCount="2"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#DCE4EF"
                      VerticalGridLinesBrush="#CBD5E1"
                      Foreground="#183153"
                      ColumnHeaderHeight="38">
                        <DataGrid.Resources>

                            <!-- DISCO - Financial Amount Display -->
                            <Style x:Key="RightAlignedAmount"
                       TargetType="TextBlock">

                                <Setter Property="TextAlignment"
                            Value="Right"/>

                                <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                <Setter Property="Margin"
                            Value="0,0,10,0"/>

                            </Style>

                            <!-- DISCO - Financial Amount Editing -->
                            <Style x:Key="RightAlignedEditing"
                                TargetType="TextBox">

                                <Setter Property="TextAlignment"
                                    Value="Right"/>

                                <Setter Property="VerticalContentAlignment"
                                    Value="Center"/>

                                <Setter Property="Padding"
                                    Value="0,0,10,0"/>

                            </Style>

                        </DataGrid.Resources>
            <DataGrid.Columns>

                <!-- ACCOUNT COMBOBOX -->
                <DataGridTemplateColumn Header="Ledger Account"
                                     x:Name="ColAccount"
                                    Width="3*">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <ComboBox
                            ItemsSource="{Binding DataContext.Accounts,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"

                            SelectedValue="{Binding AccountId,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"

                            SelectedValuePath="AccountId"
                            DisplayMemberPath="Account"
                           

                            IsEditable="True"
                            IsTextSearchEnabled="True"
                            StaysOpenOnEdit="True"
                            VerticalContentAlignment="Center"
                            Margin="2"/>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!-- DEBIT -->
                <DataGridTextColumn
                    Header="Debit"
                    Width="*"
                    x:Name="ColDebit"
                    ElementStyle="{StaticResource RightAlignedAmount}"
                    EditingElementStyle="{StaticResource RightAlignedEditing}"
                    Binding="{Binding Debit,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnExceptions=True,
                        StringFormat={}{0:N2}}"/>

                <!-- CREDIT -->
                <DataGridTextColumn
                    Header="Credit"
                    Width="*"
                    x:Name="ColCredit"
                    ElementStyle="{StaticResource RightAlignedAmount}"
                    EditingElementStyle="{StaticResource RightAlignedEditing}"
                    Binding="{Binding Credit,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnExceptions=True,
                        StringFormat={}{0:N2}}"/>

                <!-- DELETE JOURNAL ROW -->
                <DataGridTemplateColumn Header="D"
                        Width="50">
                    
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Button Content="D"
                                Width="32"
                                x:Name="ColDelete"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="DeleteJournalLine_Click"
                                ToolTip="Delete Journal Line"
                                Background="#F8D7DA"
                                Foreground="#842029"
                                BorderBrush="#E5AEB4"
                                BorderThickness="1"
                                FontWeight="SemiBold"
                                Cursor="Hand">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!-- CURRENT LEDGER BALANCE -->
                <DataGridTextColumn
                    Header="Current Balance"
                    Width="175"
                    x:Name="ColCurrentBalance"
                    ElementStyle="{StaticResource RightAlignedAmount}"
                    IsReadOnly="True"
                    Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}"/>

                <!-- BALANCE AFTER JOURNAL -->
                <DataGridTextColumn
                    Header="After Journal"
                    Width="175"
                    x:Name="ColAfterJournal"
                    ElementStyle="{StaticResource RightAlignedAmount}"
                    IsReadOnly="True"
                    Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}"/>

            </DataGrid.Columns>

        </DataGrid>
        <!-- JOURNAL TOTALS -->
        <Grid Grid.Row="2"
            Margin="0,5,0,0">


            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#183153"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>

                <ColumnDefinition
                        Width="{Binding ActualWidth, ElementName=ColAccount}"/>

                <ColumnDefinition
                        Width="{Binding ActualWidth, ElementName=ColDebit}"/>

                <ColumnDefinition
                        Width="{Binding ActualWidth, ElementName=ColCredit}"/>

                <ColumnDefinition
                        Width="{Binding ActualWidth, ElementName=ColDelete}"/>

                <ColumnDefinition
                        Width="{Binding ActualWidth, ElementName=ColCurrentBalance}"/>

                <ColumnDefinition
                        Width="{Binding ActualWidth, ElementName=ColAfterJournal}"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- TOTAL LABEL -->
            <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="TOTAL"
               FontWeight="Bold"
               FontSize="16"/>

            <!-- TOTAL DEBIT -->
            <TextBlock Grid.Row="0"
               Grid.Column="1"
               Text="{Binding TotalDebit, StringFormat={}{0:N2}}"
               Margin="0,0,10,0"
               HorizontalAlignment="Right"
               FontWeight="Bold"
               FontSize="16"/>

            <!-- TOTAL CREDIT -->
            <TextBlock Grid.Row="0"
               Grid.Column="2"
               Text="{Binding TotalCredit, StringFormat={}{0:N2}}"
               Margin="0,0,10,0"
               HorizontalAlignment="Right"
               FontWeight="Bold"
               FontSize="16"/>

            <!-- DIFFERENCE -->
            <!-- DIFFERENCE LABEL -->
            <TextBlock Grid.Row="1"
           Grid.Column="0"
           Text="TO BALANCE"
           FontWeight="Bold"
           FontSize="16"/>
            

            <!-- AMOUNT NEEDED ON DEBIT SIDE -->
            <TextBlock Grid.Row="1"
           Grid.Column="1"
           Text="{Binding DebitDifference, StringFormat={}{0:N2}}"
           Margin="0,0,10,0"
           HorizontalAlignment="Right"
           FontWeight="Bold"
           FontSize="16"/>

            <!-- AMOUNT NEEDED ON CREDIT SIDE -->
            <TextBlock Grid.Row="1"
           Grid.Column="2"
           Text="{Binding CreditDifference, StringFormat={}{0:N2}}"
           Margin="0,0,10,0"
           HorizontalAlignment="Right"
           FontWeight="Bold"
           FontSize="16"/>
            <!-- DUPLICATE ACCOUNT WARNING -->
            <TextBlock Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="3"
           Text="Duplicate Ledger Account! Each account can appear only once."
           Foreground="OrangeRed"
           FontWeight="Bold"
           FontSize="16"
           Margin="0,8,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDuplicateAccounts}"
                             Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>

            </TextBlock>
        </Grid>
        

    </Grid>
</UserControl>
