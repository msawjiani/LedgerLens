<UserControl x:Class="LedgerLens.App.Views.JournalEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LedgerLens.App.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- JOURNAL HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="Journal Entry"
               FontSize="24"
               FontWeight="Bold"
               Foreground="AliceBlue"
               Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DATE -->
                <!-- DATE LABEL -->
                <!-- DATE LABEL -->
                <TextBlock Grid.Row="0"
           Grid.Column="0"
           Text="Date"
           Foreground="White"
           FontWeight="Bold"
           FontSize="14"/>

                <!-- DATE INPUT -->
                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         Height="32"
                         Margin="0,5,10,0"
                         FontSize="16"
                         Text="{Binding DateInput,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>
                <!-- REFERENCE LABEL -->
                <!-- REFERENCE LABEL -->
                <TextBlock Grid.Row="0"
           Grid.Column="1"
           Text="Reference"
           Foreground="White"
           FontWeight="Bold"
           FontSize="14"/>

                <!-- REFERENCE INPUT -->
                <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Height="32"
                     Margin="0,5,10,0"
                     FontSize="16"
                     Text="{Binding RefInput,
                                    Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- NARRATION -->
                <!-- NARRATION LABEL -->
                <TextBlock Grid.Row="0"
           Grid.Column="2"
           Text="Narration"
           Foreground="White"
           FontWeight="Bold"
           FontSize="14"/>

                <!-- NARRATION LABEL -->
                <TextBlock Grid.Row="0"
           Grid.Column="2"
           Text="Narration"
           Foreground="White"
           FontWeight="Bold"
           FontSize="14"/>

                <!-- NARRATION INPUT -->
                <TextBox Grid.Row="1"
                     Grid.Column="2"
                     Height="32"
                     Margin="0,5,10,0"
                     FontSize="16"
                     Text="{Binding NarrationInput,
                                    Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- SAVE BUTTON -->
                <Button Grid.Row="1"
                Grid.Column="3"
                Content="SAVE"
                Height="32"
                Margin="10,5,0,0"
                FontWeight="Bold"
                IsEnabled="{Binding IsSaveEnabled}"/>

            </Grid>

            <StackPanel Orientation="Horizontal"
            Margin="0,5,0,0">

                <TextBlock Text="IsSaveEnabled: "
               Foreground="Yellow"
               FontWeight="Bold"
               FontSize="14"/>

                <Button Content="CHECK SAVE"
                    Margin="20,0,0,0"
                    Padding="10,3"
                    Click="CheckSave_Click"/>

            </StackPanel>

        </StackPanel>

        <DataGrid Grid.Row="1"
                    x:Name="JournalGrid"
                    PreviewKeyDown="JournalGrid_PreviewKeyDown"
                    ItemsSource="{Binding JournalLines}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionUnit="Cell"
                    RowHeight="36"
                    FontSize="16"
                    HeadersVisibility="Column">

                <DataGrid.Columns>

                <!-- ACCOUNT COMBOBOX -->
                <DataGridTemplateColumn Header="Ledger Account"
                                    Width="3*">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <ComboBox
                            ItemsSource="{Binding DataContext.Accounts,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"

                            SelectedValue="{Binding AccountId,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"

                            SelectedValuePath="AccountId"
                            DisplayMemberPath="Account"

                            IsEditable="True"
                            IsTextSearchEnabled="True"
                            StaysOpenOnEdit="True"
                            VerticalContentAlignment="Center"
                            Margin="2"/>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!-- DEBIT -->
                <DataGridTextColumn
                    Header="Debit"
                    Width="*"
                    Binding="{Binding Debit,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnExceptions=True,
                        StringFormat={}{0:N2}}"/>

                <!-- CREDIT -->
                <DataGridTextColumn
                    Header="Credit"
                    Width="*"
                    Binding="{Binding Credit,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnExceptions=True,
                        StringFormat={}{0:N2}}"/>

                <!-- DELETE JOURNAL ROW -->
                <DataGridTemplateColumn Header="D"
                        Width="50">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Button Content="D"
                    Width="30"
                    Height="25"
                    Background="Crimson"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="DeleteJournalLine_Click"/>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!-- CURRENT LEDGER BALANCE -->
                <DataGridTextColumn
                    Header="Current Balance"
                    Width="175"
                    IsReadOnly="True"
                    Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}"/>

                <!-- BALANCE AFTER JOURNAL -->
                <DataGridTextColumn
                    Header="After Journal"
                    Width="175"
                    IsReadOnly="True"
                    Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}"/>

            </DataGrid.Columns>

        </DataGrid>
        <!-- JOURNAL TOTALS -->
        <Grid Grid.Row="2"
            Margin="0,5,0,0">
            
            
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="AliceBlue"/>
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <!-- Ledger Account -->
                <ColumnDefinition Width="350"/>

                <!-- Debit -->
                <ColumnDefinition Width="160"/>

                <!-- Credit -->
                <ColumnDefinition Width="160"/>

                <!-- D Button -->
                <ColumnDefinition Width="50"/>

                <!-- Current Balance -->
                <ColumnDefinition Width="175"/>

                <!-- After Journal -->
                <ColumnDefinition Width="175"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- TOTAL LABEL -->
            <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="TOTAL"
               FontWeight="Bold"
               FontSize="16"/>

            <!-- TOTAL DEBIT -->
            <TextBlock Grid.Row="0"
               Grid.Column="1"
               Text="{Binding TotalDebit, StringFormat={}{0:N2}}"
               HorizontalAlignment="Right"
               FontWeight="Bold"
               FontSize="16"/>

            <!-- TOTAL CREDIT -->
            <TextBlock Grid.Row="0"
               Grid.Column="2"
               Text="{Binding TotalCredit, StringFormat={}{0:N2}}"
               HorizontalAlignment="Right"
               FontWeight="Bold"
               FontSize="16"/>

            <!-- DIFFERENCE -->
            <!-- DIFFERENCE LABEL -->
            <TextBlock Grid.Row="1"
           Grid.Column="0"
           Text="TO BALANCE"
           FontWeight="Bold"
           FontSize="16"/>
            

            <!-- AMOUNT NEEDED ON DEBIT SIDE -->
            <TextBlock Grid.Row="1"
           Grid.Column="1"
           Text="{Binding DebitDifference, StringFormat={}{0:N2}}"
           HorizontalAlignment="Right"
           FontWeight="Bold"
           FontSize="16"/>

            <!-- AMOUNT NEEDED ON CREDIT SIDE -->
            <TextBlock Grid.Row="1"
           Grid.Column="2"
           Text="{Binding CreditDifference, StringFormat={}{0:N2}}"
           HorizontalAlignment="Right"
           FontWeight="Bold"
           FontSize="16"/>
            <!-- DUPLICATE ACCOUNT WARNING -->
            <TextBlock Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="3"
           Text="Duplicate Ledger Account! Each account can appear only once."
           Foreground="OrangeRed"
           FontWeight="Bold"
           FontSize="16"
           Margin="0,8,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDuplicateAccounts}"
                             Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>

            </TextBlock>
        </Grid>
        

    </Grid>
</UserControl>
