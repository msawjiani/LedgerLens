<UserControl x:Class="LedgerLens.App.Views.TurboSharePurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DISCO - Header and Import Details -->
        <StackPanel Grid.Row="0"
            Margin="0,0,0,15">

            <TextBlock Text="TURBO Share Purchase"
               FontSize="26"
               FontWeight="SemiBold"
               Foreground="#183153"
               Margin="0,0,0,20"/>

            <Border Background="#E4EAF2"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <!-- Reference -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Reference"
                           Foreground="#183153"
                           Margin="0,0,0,5"/>

                        <TextBox x:Name="BatchReferenceTextBox"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Narration -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Narration"
                           Foreground="#183153"
                           Margin="0,0,0,5"/>

                        <TextBox x:Name="BatchNarrationTextBox"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Select Excel -->
                    <Button x:Name="SelectExcelButton"
                    Grid.Column="4"
                    Content="SELECT EXCEL"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Background="#2878B5"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SelectExcelButton_Click"/>

                    <!-- Import -->
                    <Button x:Name="ImportButton"
                    Grid.Column="6"
                    Content="IMPORT"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Background="#21865B"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="ImportButton_Click"
                    IsEnabled="False"/>

                </Grid>

            </Border>

        </StackPanel>

        <!-- IMPORT GRID -->
        <!-- DISCO - Excel Share Purchases Panel -->
        <Border Grid.Row="1"
        Background="#E4EAF2"
        BorderBrush="#CBD5E1"
        BorderThickness="1"
        CornerRadius="12"
        Padding="12"
        Margin="0,0,0,15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="Excel Share Purchases"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,8"/>

                <DataGrid x:Name="TurboGrid"
                      Grid.Row="1"
                      
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      Background="#E4EAF2"
                      RowBackground="#E4EAF2"
                      AlternatingRowBackground="#EDF1F6"
                      AlternationCount="2"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      GridLinesVisibility="None"
                      Foreground="#183153"
                      FontFamily="Segoe UI"
                      FontSize="14"
                      RowHeight="30"
                      ColumnHeaderHeight="35"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Resources>

                        <!-- DISCO - Right Aligned Financial Amounts -->
                                <Style x:Key="RightAlignedAmount"
                                   TargetType="TextBlock">

                                    <Setter Property="TextAlignment"
                                    Value="Right"/>

                                    <Setter Property="VerticalAlignment"
                                    Value="Center"/>

                                    <Setter Property="Margin"
                                    Value="0,0,10,0"/>

                                </Style>

                    </DataGrid.Resources>
                    <DataGrid.Columns>

                    <DataGridTextColumn Header="Row"
                                        Binding="{Binding ExcelRowNumber}"
                                        Width="50"/>

                    <DataGridTextColumn Header="GL Credit"
                                        Binding="{Binding GLAccountForCredit}"
                                        Width="130"/>

                    <DataGridTextColumn Header="GL Debit"
                                        Binding="{Binding GLSharesAccountForDebit}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Company"
                                        Binding="{Binding Company}"
                                        Width="*"
                                        MinWidth="180"/>

                    <DataGridTextColumn Header="Trade Date"
                                        Binding="{Binding TradeDate, StringFormat={}{0:dd-MMM-yyyy}}"
                                        Width="110"/>

                        <DataGridTextColumn Header="Quantity"
                                Binding="{Binding Qty, StringFormat={}{0:0.######}}"
                                ElementStyle="{StaticResource RightAlignedAmount}"
                                Width="100"/>

                        <DataGridTextColumn Header="Rate"
                                Binding="{Binding Rate, StringFormat={}{0:0.######}}"
                                ElementStyle="{StaticResource RightAlignedAmount}"
                                Width="100"/>

                        <DataGridTextColumn Header="Amount"
                                Binding="{Binding Amt, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource RightAlignedAmount}"
                                Width="110"/>

                        <DataGridTextColumn Header="Error"
                                        Binding="{Binding ErrorMessage}"
                                        Width="180">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="Firebrick"/>
                                <Setter Property="TextWrapping"
                                        Value="Wrap"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <!-- DELETE ROW -->
                        <!-- DISCO - DELETE ROW -->
                        <DataGridTemplateColumn Header="D"
                        Width="55">

                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button Content="D"
                    Width="32"
                    Height="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F8D7DA"
                    Foreground="#842029"
                    BorderBrush="#E5AEB4"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    ToolTip="Remove Excel Row"
                    Click="DeleteRow_Click">

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                                                    <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>
                                        </Button.Template>

                                    </Button>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

            </DataGrid>

            </Grid>
        </Border>

        <!-- IMPORT SUMMARY -->
        <Border Grid.Row="2"
            Background="#E4EAF2"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            Padding="12"
            CornerRadius="12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TotalRowsText"
                           Grid.Column="0"
                           Text="Rows: 0"
                           Foreground="#183153"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="ValidRowsText"
                           Grid.Column="1"
                           Text="Valid: 0"
                           FontWeight="SemiBold"
                           Foreground="DarkGreen"/>

                <TextBlock x:Name="ErrorRowsText"
                           Grid.Column="2"
                           Text="Errors: 0"
                           FontWeight="SemiBold"
                           Foreground="Firebrick"/>

                <TextBlock x:Name="TotalAmountText"
                           Grid.Column="3"
                           Text="Total Amount: ₹0.00"
                           Foreground="#183153"
                           HorizontalAlignment="Right"
                           FontWeight="Bold"
                           FontSize="15"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>