<UserControl x:Class="LedgerLens.App.Views.TurboSharePurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="TURBO SHARE PURCHASE"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#243B53"/>

                <TextBlock Text="Import Share Purchases from Excel"
                           FontSize="13"
                           Foreground="Gray"
                           Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                                        <StackPanel Width="160" Margin="0,0,15,0">
                                            <TextBlock Text="Reference"/>
                                            <TextBox x:Name="BatchReferenceTextBox"
                                     Height="28"
                                     Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Width="380">
                        <TextBlock Text="Narration"/>
                        <TextBox x:Name="BatchNarrationTextBox"
                 Height="28"
                 Margin="0,4,0,0"/>
                    </StackPanel>

                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="SelectExcelButton"
                        Content="SELECT EXCEL"
                        Width="140"
                        Height="35"
                        Margin="0,0,10,0"
                        Background="#2878B5"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="SelectExcelButton_Click"/>

                <Button x:Name="ImportButton"
                        Content="IMPORT"
                        Width="110"
                        Height="35"
                        Background="#21865B"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="ImportButton_Click"
                        IsEnabled="False"/>

            </StackPanel>

        </Grid>

        <!-- IMPORT GRID -->
        <GroupBox Grid.Row="1"
                  Header="Excel Share Purchases"
                  FontWeight="SemiBold"
                  Padding="10"
                  Margin="0,0,0,15">

            <DataGrid x:Name="TurboGrid"
                      Height="340"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      RowHeight="30"
                      ColumnHeaderHeight="35"
                      FontSize="13"
                      AlternatingRowBackground="#EEF4FA"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Row"
                                        Binding="{Binding ExcelRowNumber}"
                                        Width="50"/>

                    <DataGridTextColumn Header="GL Credit"
                                        Binding="{Binding GLAccountForCredit}"
                                        Width="130"/>

                    <DataGridTextColumn Header="GL Debit"
                                        Binding="{Binding GLSharesAccountForDebit}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Company"
                                        Binding="{Binding Company}"
                                        Width="*"
                                        MinWidth="180"/>

                    <DataGridTextColumn Header="Trade Date"
                                        Binding="{Binding TradeDate, StringFormat={}{0:dd-MMM-yyyy}}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Quantity"
                                        Binding="{Binding Qty, StringFormat={}{0:0.######}}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Rate"
                                        Binding="{Binding Rate, StringFormat={}{0:0.######}}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Amount"
                                        Binding="{Binding Amt, StringFormat={}{0:N2}}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Error"
                                        Binding="{Binding ErrorMessage}"
                                        Width="180">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="Firebrick"/>
                                <Setter Property="TextWrapping"
                                        Value="Wrap"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <!-- DELETE ROW -->
                    <DataGridTemplateColumn Header="Action"
                                            Width="70">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="D"
                                    Width="30"
                                    Height="25"
                                    Background="#A32D41"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="DeleteRow_Click"/>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- IMPORT SUMMARY -->
        <Border Grid.Row="2"
                Background="#EEF4FA"
                Padding="15"
                CornerRadius="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TotalRowsText"
                           Grid.Column="0"
                           Text="Rows: 0"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="ValidRowsText"
                           Grid.Column="1"
                           Text="Valid: 0"
                           FontWeight="SemiBold"
                           Foreground="DarkGreen"/>

                <TextBlock x:Name="ErrorRowsText"
                           Grid.Column="2"
                           Text="Errors: 0"
                           FontWeight="SemiBold"
                           Foreground="Firebrick"/>

                <TextBlock x:Name="TotalAmountText"
                           Grid.Column="3"
                           Text="Total Amount: ₹0.00"
                           HorizontalAlignment="Right"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="#243B53"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>