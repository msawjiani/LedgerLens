<UserControl x:Class="LedgerLens.App.Views.ShareSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="SHARE SALES"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#183153"/>

            <TextBlock Text="Record share sales with FIFO allocation and capital gains"
                       FontSize="12"
                       Foreground="#74839A"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- ACCOUNT SELECTION -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="BROKER ACCOUNT (DEBIT)"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="BrokerAccountCombo"
                              Height="34"
                              Margin="0,6,0,0"
                              DisplayMemberPath="Account"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SHARES ACCOUNT (CREDIT)"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="SharesAccountCombo"
                              Height="34"
                              Margin="0,6,0,0"
                              SelectionChanged="SharesAccountCombo_SelectionChanged"
                              DisplayMemberPath="Account"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- JOURNAL DETAILS -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DATE"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="DateTextBox"
                             Height="32"
                             Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="REFERENCE"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="ReferenceTextBox"
                             Height="32"
                             Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="NARRATION"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="NarrationTextBox"
                             Height="32"
                             Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="QUANTITY"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="QuantityTextBox"
                             Height="32"
                             Margin="0,6,0,0"
                             TextAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock Text="SELLING RATE"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="SellingRateTextBox"
                             Height="32"
                             Margin="0,6,0,0"
                             TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- COMPANY HOLDINGS -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="SELECT COMPANY"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#183153"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="CompanyGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionChanged="CompanyGrid_SelectionChanged"
                          RowHeight="29">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SHARE ID"
                                            Binding="{Binding ShareId}"
                                            Width="100"/>

                        <DataGridTextColumn Header="COMPANY"
                                            Binding="{Binding Company}"
                                            Width="*"/>

                        <DataGridTextColumn Header="AVAILABLE QTY"
                                            Binding="{Binding AvailableQty}"
                                            Width="150"/>
                    </DataGrid.Columns>

                </DataGrid>
            </DockPanel>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Select a company and enter sale details"
                       Foreground="#74839A"
                       VerticalAlignment="Center"/>

            <Button x:Name="SaveShareSaleButton"
                    Grid.Column="1"
                    Content="SAVE SHARE SALE"
                    Width="160"
                    Height="38"
                    Background="#168A60"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="SaveShareSale_Click"
                    IsEnabled="True"/>
        </Grid>

    </Grid>
</UserControl>