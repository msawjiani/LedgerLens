<UserControl x:Class="LedgerLens.App.Views.ShareSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DISCO - Share Sales Heading -->
        <TextBlock Grid.Row="0"
           Text="Share Sales"
           FontSize="26"
           FontWeight="SemiBold"
           Foreground="#183153"
           Margin="0,0,0,20"/>

   

        <!-- ACCOUNT SELECTION -->
        <!-- DISCO - Account Information Panel -->
        <Border Grid.Row="1"
        Background="#E4EAF2"
        BorderBrush="#CBD5E1"
        BorderThickness="1"
        CornerRadius="12"
        Padding="12"
        Margin="0,0,0,10">

            <StackPanel>

                <TextBlock Text="Account Information"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,8"/>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                        <TextBlock Text="Broker Account (Debit)"
                                Foreground="#183153"/>

                        <ComboBox x:Name="BrokerAccountCombo"
                              Height="34"
                              Margin="0,6,0,0"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="Account"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                        <TextBlock Text="Shares Account (Credit)"
                                Foreground="#183153"/>

                        <ComboBox x:Name="SharesAccountCombo"
                              Height="34"
                              Margin="0,6,0,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="SharesAccountCombo_SelectionChanged"
                              DisplayMemberPath="Account"/>
                </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- JOURNAL DETAILS -->
        <!-- DISCO - Transaction Details Panel -->
        <Border Grid.Row="2"
                Background="#E4EAF2"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,10">

            <StackPanel>

                <TextBlock Text="Transaction Details"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,8"/>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                        <TextBlock Text="Date"
                                Foreground="#183153"/>
                        <TextBox x:Name="DateTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                        <TextBlock Text="Reference"
                            Foreground="#183153"/>
                        <TextBox x:Name="ReferenceTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                        <TextBlock Text="Narration"
                            Foreground="#183153"/>
                        <TextBox x:Name="NarrationTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                        <TextBlock Text="Quantity"
                            Foreground="#183153"/>
                        <TextBox x:Name="QuantityTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Margin="0,6,0,0"
                             TextAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Column="8">
                        <TextBlock Text="Selling Rate"
                            Foreground="#183153"/>
                        <TextBox x:Name="SellingRateTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Margin="0,6,0,0"
                             TextAlignment="Right"/>
                </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- DISCO - Company Holdings Panel -->
                <Border Grid.Row="3"
                    Background="#E4EAF2"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,10">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                       Text="Select Company"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#183153"
                       Margin="0,0,0,8"/>

                <DataGrid x:Name="CompanyGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          SelectionChanged="CompanyGrid_SelectionChanged"
                          Background="#E4EAF2"
                          RowBackground="#E4EAF2"
                          AlternatingRowBackground="#EDF1F6"
                          AlternationCount="2"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#DCE4EF"
                          Foreground="#183153"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          RowHeight="26"
                          ColumnHeaderHeight="32">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Share ID"
                                            Binding="{Binding ShareId}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Company"
                                            Binding="{Binding Company}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Available Qty"
                                            Binding="{Binding AvailableQty}"
                                            Width="150"/>
                    </DataGrid.Columns>

                </DataGrid>
            </DockPanel>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                   Text="Select a company and enter sale details"
                   Foreground="#183153"
                   VerticalAlignment="Center"/>

            <Button x:Name="SaveShareSaleButton"
                    Grid.Column="1"
                    Content="SAVE SHARE SALE"
                    Width="160"
                    Height="38"
                    Background="#168A60"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="SaveShareSale_Click"
                    IsEnabled="True"/>
        </Grid>

    </Grid>
</UserControl>