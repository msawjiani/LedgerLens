<UserControl x:Class="LedgerLens.App.Views.BankEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0"
                   Text="Bank Entry"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- Bank selection -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Bank / Cash Account"
                       Foreground="#CCCCCC"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding BankAccounts}"
                      SelectedItem="{Binding SelectedBank}"
                      DisplayMemberPath="Account"
                      Height="34"
                      VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="Current Balance"
                       Foreground="#CCCCCC"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <TextBlock Grid.Column="4"
                       Text="{Binding CurrentBalance, StringFormat=N2}"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>
        <!-- Transaction Entry -->
        <Border Grid.Row="2"
        Padding="14"
        Margin="0,0,0,16"
        BorderBrush="#333333"
        BorderThickness="1"
        CornerRadius="4">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <!-- Date -->
                <StackPanel Grid.Column="0"
                    Margin="0,0,12,0">
                    <TextBlock Text="Date"
                       Foreground="#CCCCCC"
                       Margin="0,0,0,5"/>

                    <TextBox Height="32"
                     Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>    
                </StackPanel>

                <!-- Reference -->
                <StackPanel Grid.Column="1"
                    Margin="0,0,12,0">
                    <TextBlock Text="Reference"
                       Foreground="#CCCCCC"
                       Margin="0,0,0,5"/>
                    <TextBox Height="32"
                         Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>    
                </StackPanel>

                <!-- Account -->
                <!-- Account -->
                <StackPanel Grid.Column="2"
            Margin="0,0,12,0">

                    <TextBlock Text="Account"
               Foreground="#CCCCCC"
               Margin="0,0,0,5"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                  Height="32"
                  ItemsSource="{Binding GLAccounts}"
                  SelectedItem="{Binding SelectedGLAccount}"
                  DisplayMemberPath="Account"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                Content="SL"
                Width="42"
                Height="32"
                Margin="6,0,0,0">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSubledgerButton}"
                                     Value="True">
                                            <Setter Property="Visibility"
                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                        </Button>

                    </Grid>

                </StackPanel>
                <!-- Amount -->
                <StackPanel Grid.Column="3"
                    Margin="0,0,12,0">
                    <TextBlock Text="Amount"
                       Foreground="#CCCCCC"
                       Margin="0,0,0,5"/>

                    <TextBox Height="32"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Receipt / Payment -->
                <StackPanel Grid.Column="4"
                    Margin="0,0,12,0">
                    <TextBlock Text="Type"
                       Foreground="#CCCCCC"
                       Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal"
                        Height="32"
                        VerticalAlignment="Center">

                        <RadioButton Content="Receipt"
                                     IsChecked="{Binding IsReceipt}"
                                     Foreground="White"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"/>

                        <RadioButton Content="Payment"
                                     IsChecked="{Binding IsPayment}"
                                     Foreground="White"
                                     VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Narration -->
                <StackPanel Grid.Column="5"
                    Margin="0,0,12,0">
                    <TextBlock Text="Narration"
                       Foreground="#CCCCCC"
                       Margin="0,0,0,5"/>

                    <TextBox Height="32"
                             Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Save -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text=" "
                       Margin="0,0,0,5"/>

                    <Button Content="SAVE"
                    Height="32"
                    FontWeight="SemiBold"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Existing transactions -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding BankEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Date"
                                    Binding="{Binding TDate, StringFormat=dd-MMM-yyyy}"
                                    Width="120"/>

                <DataGridTextColumn Header="Ref"
                                    Binding="{Binding Ref}"
                                    Width="110"/>

                <DataGridTextColumn Header="Particulars"
                                    Binding="{Binding Particulars}"
                                    Width="*"/>

                <DataGridTextColumn Header="Amount"
                                    Binding="{Binding Amount, StringFormat=N2}"
                                    Width="130"/>

                <DataGridTextColumn Header="Balance"
                                    Binding="{Binding RunningBalance, StringFormat=N2}"
                                    Width="140"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>