<UserControl x:Class="LedgerLens.App.Views.BankEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0"
                   Text="Bank Entry"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,20"/>

        <!-- Bank selection -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Bank / Cash Account"
                       Foreground="#183153"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding BankAccounts}"
                      SelectedItem="{Binding SelectedBank}"
                      DisplayMemberPath="Account"
                      Height="34"
                      VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="Current Balance"
                       Foreground="#183153"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <TextBlock Grid.Column="4"
                       Text="{Binding CurrentBalance, StringFormat=N2}"
                       Foreground="#183153"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>
        </Grid>
        <!-- Transaction Entry -->
        <!-- DISCO - Transaction Entry Panel -->
        <Border Grid.Row="2"
                Background="#E4EAF2"
                Padding="18"
                Margin="0,0,0,18"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="90"/>

                </Grid.ColumnDefinitions>

                <!-- Date -->
                <StackPanel Grid.Column="0"
                    Margin="0,0,12,0">
                    <TextBlock Text="Date"
                       Foreground="#183153"
                       Margin="0,0,0,5"/>

                    <TextBox Height="32"
                             Text="{Binding EntryDate, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>        
                </StackPanel>

                <!-- Reference -->
                <StackPanel Grid.Column="1"
                    Margin="0,0,12,0">
                    <TextBlock Text="Reference"
                       Foreground="#183153"
                       Margin="0,0,0,5"/>
                    <TextBox Height="32"
                         Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>    
                </StackPanel>

                
                
                <!-- Account -->
                <StackPanel Grid.Column="2"
            Margin="0,0,12,0">

                    <TextBlock Text="Account"
               Foreground="#183153"
               Margin="0,0,0,5"/>
                    <ComboBox x:Name="GLAccountCombo"
                          Height="32"
                          ItemsSource="{Binding GLAccountsView}"
                          SelectedItem="{Binding SelectedGLAccount, Mode=TwoWay}"
                          Loaded="GLAccountCombo_Loaded"   
                          SelectionChanged="GLAccountCombo_SelectionChanged"
                          DisplayMemberPath="Account"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          IsSynchronizedWithCurrentItem="False"
                          VerticalContentAlignment="Center"/>
                </StackPanel>
                <!-- Subledger -->
                <StackPanel Grid.Column="5">
                    

                    <!-- Blank label keeps button aligned with other inputs -->
                    <TextBlock Text=" "
               Margin="0,0,0,5"/>

                    <Button 
                         x:Name="SLButton"
                        Content="SL"
                        Width="42"
                        Height="32"
                        Click="Subledger_Click"
                        HorizontalAlignment="Left">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility"
                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSubledgerButton}"
                                 Value="True">
                                        <Setter Property="Visibility"
                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                    </Button>

                </StackPanel>
                <!-- Amount -->
                <StackPanel Grid.Column="3"
                    Margin="0,0,12,0">
                    <TextBlock Text="Amount"
                       Foreground="#183153"
                       Margin="0,0,0,5"/>

                    <TextBox Height="32"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Receipt / Payment -->
                <StackPanel Grid.Column="4"
                    Margin="0,0,12,0">
                    <TextBlock Text="Type"
                       Foreground="#183153"
                       Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal"
                        Height="32"
                        VerticalAlignment="Center">

                        <RadioButton Content="Receipt"
                                     IsChecked="{Binding IsReceipt}"
                                     Foreground="#183153"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"/>

                        <RadioButton Content="Payment"
                                     IsChecked="{Binding IsPayment}"
                                     Foreground="#183153"
                                     VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Narration -->
                <StackPanel Grid.Column="6"
                    Margin="0,0,12,0">
                    <TextBlock Text="Narration"
                       Foreground="#183153"
                       Margin="0,0,0,5"/>

                    <TextBox Height="32"
                             Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Save -->
                <StackPanel Grid.Column="7">
                    <TextBlock Text=" "
                       Margin="0,0,0,5"/>

                    <Button Content="SAVE"
                     Click="Save_Click"
                    Height="32"
                    FontWeight="SemiBold"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Existing transactions -->
        <!-- DISCO - Bank Transactions -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding BankEntries}"
                  VerticalScrollBarVisibility="Hidden"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="#E4EAF2"
                  RowBackground="#E4EAF2"
                  AlternatingRowBackground="#EDF1F6"
                  AlternationCount="2"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#DCE4EF"
                  Foreground="#183153"
                  FontFamily="Segoe UI"
                  FontSize="14"
                  RowHeight="34"
                  ColumnHeaderHeight="38">
            <DataGrid.Resources>

                <!-- DISCO - Right Aligned Financial Amounts -->

                <Style x:Key="RightAlignedAmount"
                    TargetType="TextBlock">

                    <Setter Property="TextAlignment"
                         Value="Right"/>

                    <Setter Property="VerticalAlignment"
                        Value="Center"/>

                    <Setter Property="Margin"
                         Value="0,0,10,0"/>

                </Style>

            </DataGrid.Resources>
            <DataGrid.Columns>
               
                <DataGridTextColumn Header="Date"
                                    Binding="{Binding TDate, StringFormat=dd-MMM-yyyy}"
                                    Width="120"/>

                <DataGridTemplateColumn Header="Ref" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Ref}"
                                   VerticalAlignment="Center"
                                   Padding="4,0">

                                <TextBlock.ToolTip>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold"
                                   Text="{Binding Unix, StringFormat='UNIX: {0}'}"/>

                                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding Narration, StringFormat='Narration: {0}'}"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"/>
                                    </StackPanel>
                                </TextBlock.ToolTip>

                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                <DataGridTextColumn Header="Particulars"
                                    Binding="{Binding Particulars}"
                                    Width="*"/>

                <DataGridTextColumn Header="Amount"
                    Binding="{Binding Amount, StringFormat=N2}"
                    ElementStyle="{StaticResource RightAlignedAmount}"
                    Width="130"/>

                <DataGridTextColumn Header="Balance"
                    Binding="{Binding RunningBalance, StringFormat=N2}"
                    ElementStyle="{StaticResource RightAlignedAmount}"
                    Width="140"/>

                <!-- Delete Transaction -->
                <DataGridTemplateColumn Header="D"
                        Width="55"
                        CanUserSort="False">

                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>

                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="D"
                                                Width="32"
                                                Height="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="DeleteBankEntry_Click"
                                                ToolTip="Delete Bank Entry"
                                                Background="#F8D7DA"
                                                Foreground="#842029"
                                                BorderBrush="#E5AEB4"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">

                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="7">

                                                            <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>
                                                </Button.Template>

                                            </Button>

                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>