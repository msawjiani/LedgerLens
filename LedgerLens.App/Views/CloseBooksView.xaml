<UserControl x:Class="LedgerLens.App.Views.CloseBooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">

            <TextBlock Text="CLOSING BOOKS"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#183153"/>

            <TextBlock Text="Financial year closing and opening journal entries"
                       FontSize="12"
                       Foreground="#74839A"
                       Margin="0,3,0,0"/>

        </StackPanel>

        <!-- FINANCIAL YEAR INFORMATION -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="INDIVIDUAL"
                               FontWeight="SemiBold"
                               FontSize="12"/>

                    <TextBlock x:Name="IndividualText"
                               FontSize="16"
                               Foreground="#183153"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1">

                    <TextBlock Text="CLOSING FINANCIAL YEAR"
                               FontWeight="SemiBold"
                               FontSize="12"/>

                    <TextBlock x:Name="ClosingYearText"
                               FontSize="15"
                               Foreground="#183153"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="NEXT FINANCIAL YEAR"
                               FontWeight="SemiBold"
                               FontSize="12"/>

                    <TextBlock x:Name="OpeningYearText"
                               FontSize="15"
                               Foreground="#183153"
                               Margin="0,6,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- VALIDATION SUMMARY -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <StackPanel>

                <TextBlock Text="PRE-CLOSING VALIDATION"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#183153"
                           Margin="0,0,0,10"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="TRIAL BALANCE"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="TrialBalanceText"
                                   Foreground="#168A60"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="UNBALANCED UNIX"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="UnixValidationText"
                                   Foreground="#168A60"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="RETAINED EARNINGS"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="RetainedEarningsText"
                                   Foreground="#168A60"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="3">

                        <TextBlock Text="CLOSING STATUS"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ClosingStatusText"
                                   Foreground="#168A60"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </Border>

        <!-- JOURNAL ENTRY PREVIEW -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="CLOSING &amp; OPENING JOURNAL ENTRIES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#183153"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="ClosingEntriesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="29">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="YEAR"
                                            Binding="{Binding Period}"
                                            Width="100"/>

                        <DataGridTextColumn Header="DATE"
                                            Binding="{Binding Tdate, StringFormat=dd-MMM-yyyy}"
                                            Width="110"/>

                        <DataGridTextColumn Header="REF"
                                            Binding="{Binding Ref}"
                                            Width="145"/>

                        <DataGridTextColumn Header="PARTICULARS"
                                            Binding="{Binding Particulars}"
                                            Width="*"/>

                        <DataGridTextColumn Header="DEBIT"
                                            Binding="{Binding Debit, StringFormat=N2}"
                                            Width="130"/>

                        <DataGridTextColumn Header="CREDIT"
                                            Binding="{Binding Credit, StringFormat=N2}"
                                            Width="130"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </Border>

        <!-- CLOSING SUMMARY -->

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ClosingCountText"
                           Grid.Column="0"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="OpeningCountText"
                           Grid.Column="1"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="ClosingDifferenceText"
                           Grid.Column="2"
                           FontWeight="SemiBold"
                           Foreground="#168A60"/>

                <TextBlock x:Name="OpeningDifferenceText"
                           Grid.Column="3"
                           FontWeight="SemiBold"
                           Foreground="#168A60"/>

            </Grid>

        </Border>

        <!-- CONFIRMATION AND BUTTONS -->

        <Border Grid.Row="5"
                Background="White"
                CornerRadius="10"
                Padding="14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="CONFIRMATION 1"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="ConfirmYesTextBox"
                             Height="32"
                             Margin="0,6,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="CONFIRMATION 2"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="ConfirmCloseTextBox"
                             Height="32"
                             Margin="0,6,0,0"/>

                </StackPanel>

                <Button x:Name="CloseBooksButton"
                        Grid.Column="4"
                        Content="CLOSE BOOKS"
                        Width="140"
                        Height="38"
                        Background="#168A60"
                        Foreground="White"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        VerticalAlignment="Bottom"/>

                <Button x:Name="CancelButton"
                        Grid.Column="6"
                        Content="CANCEL"
                        Width="140"
                        Height="38"
                        Background="#74839A"
                        Foreground="White"
                        FontWeight="SemiBold"
                        IsEnabled="True"
                        Click="CancelButton_Click"
                        VerticalAlignment="Bottom"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>