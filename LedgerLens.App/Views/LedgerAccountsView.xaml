<UserControl x:Class="LedgerLens.App.Views.LedgerAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Grid -->
        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ledger Accounts"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,16"/>

            <TextBox Grid.Row="1"
                     Height="36"
                     Margin="0,0,0,14"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="15"/>

            <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredAccounts}"
                  SelectedItem="{Binding SelectedAccount,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding AccountId}" Width="80"/>
                    <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                    <DataGridTextColumn Header="Subledger" Binding="{Binding SubledgerFlag}" Width="100"/>
                    <DataGridTextColumn Header="Dashboard Group" Binding="{Binding DashboardGroup}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- RIGHT: Editor -->
        <Border Grid.Column="1"
                Background="#1F2937"
                CornerRadius="10"
                Padding="22">

            <StackPanel>
                <TextBlock Text="Editor"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Account ID" Foreground="#D1D5DB"/>
                <TextBox Text="{Binding EditingAccount.AccountId}"
                    IsReadOnly="True"
                        Margin="0,4,0,14"/>

                <TextBlock Text="Account" Foreground="#D1D5DB"/>
                <TextBox Text="{Binding EditingAccount.Account}" Margin="0,4,0,14"/>

                <TextBlock Text="Category" Foreground="#D1D5DB"/>
                <ComboBox ItemsSource="{Binding CategoryOptions}"
                    SelectedItem="{Binding EditingAccount.Category}"
                        Margin="0,4,0,14"/>

                <TextBlock Text="Subledger Flag" Foreground="#D1D5DB"/>
                <ComboBox ItemsSource="{Binding SubledgerFlagOptions}"
                    SelectedItem="{Binding EditingAccount.SubledgerFlag}"
                    Margin="0,4,0,14"/>
                <TextBlock Text="Dashboard Group" Foreground="#D1D5DB"/>
                <ComboBox ItemsSource="{Binding DashboardGroupOptions}"
                      SelectedItem="{Binding EditingAccount.DashboardGroup}"
                      Margin="0,4,0,22"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="New"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="New_Click"/>
                    <Button Content="Save"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="Save_Click"/>
                    <Button Content="Clear" Width="80"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>