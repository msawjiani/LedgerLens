<UserControl x:Class="LedgerLens.App.Views.ReconcilerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
    <UserControl.Resources>
        <Style x:Key="RightAlignedAmount"
                                                TargetType="TextBlock">
            <Setter Property="TextAlignment"
                                                Value="Right"/>
            <Setter Property="Padding"
                                                Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0" Margin="0,0,0,14">

            <TextBlock Text="RECONCILER"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#183153"/>

            <TextBlock Text="Compare inter-individual ledger transactions"
                       FontSize="12"
                       Foreground="#74839A"
                       Margin="0,3,0,0"/>

        </StackPanel>

        <!-- DATABASE INFORMATION -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="SOURCE INDIVIDUAL"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="SourceIndividualText"
                               Margin="0,8,0,0"
                               FontSize="16"
                               Foreground="#183153"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="TARGET INDIVIDUAL"
                               FontWeight="SemiBold"/>

                    <DockPanel Margin="0,6,0,0">

                        <Button x:Name="SelectTargetButton"
                                Content="SELECT ACCDB"
                                Width="125"
                                Height="32"
                                DockPanel.Dock="Right"
                                Margin="10,0,0,0"/>

                        <TextBlock x:Name="TargetIndividualText"
                                   Text="Not Selected"
                                   FontSize="16"
                                   Foreground="#74839A"
                                   VerticalAlignment="Center"/>

                    </DockPanel>

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <TextBlock Text="FINANCIAL YEAR"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="FinancialYearText"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#183153"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ACCOUNT SELECTION -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="SOURCE ACCOUNT"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="SourceAccountCombo"
                              Height="34"
                              Margin="0,6,0,0"
                              DisplayMemberPath="Account"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="TARGET ACCOUNT"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="TargetAccountCombo"
                              Height="34"
                              Margin="0,6,0,0"
                              DisplayMemberPath="Account"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- COLOUR MARKERS -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="MANUAL MARKERS"
                           FontWeight="SemiBold"
                           Foreground="#183153"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <Button x:Name="BlueMarkerButton"
                        Content="BLUE"
                        Background="#CDE5FF"
                        Width="78"
                        Height="30"
                        Margin="0,0,8,0"/>

                <Button x:Name="YellowMarkerButton"
                        Content="YELLOW"
                        Background="#FFF3B0"
                        Width="78"
                        Height="30"
                        Margin="0,0,8,0"/>

                <Button x:Name="OrangeMarkerButton"
                        Content="ORANGE"
                        Background="#FFD8B0"
                        Width="78"
                        Height="30"
                        Margin="0,0,8,0"/>

                <Button x:Name="PurpleMarkerButton"
                        Content="PURPLE"
                        Background="#E7D6FF"
                        Width="78"
                        Height="30"
                        Margin="0,0,8,0"/>

                <Button x:Name="PinkMarkerButton"
                        Content="PINK"
                        Background="#FFD6E7"
                        Width="78"
                        Height="30"
                        Margin="0,0,8,0"/>

                <Button x:Name="TealMarkerButton"
                        Content="TEAL"
                        Background="#C6F1EB"
                        Width="78"
                        Height="30"
                        Margin="0,0,8,0"/>

                <Button x:Name="ClearMarkerButton"
                        Content="CLEAR"
                        Width="78"
                        Height="30"/>

            </StackPanel>

        </Border>

        <!-- TWO TRANSACTION GRIDS -->

        <Grid Grid.Row="4"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOURCE GRID -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="14">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="SOURCE TRANSACTIONS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#183153"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="SourceGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="29">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                        <Setter Property="Background"
                                                Value="{Binding RowColor}"/>

                            <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                Value="True">
                                                <Setter Property="Background"
                                Value="{Binding RowColor}"/>
                                                <Setter Property="Foreground"
                                Value="Black"/>
                                            </Trigger>
                                        </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="DATE"
                                Binding="{Binding TDate, StringFormat=dd-MMM}"
                                Width="70"/>

                            <DataGridTextColumn Header="REF"
                                                Binding="{Binding Ref}"
                                                Width="95"/>

                            <DataGridTextColumn Header="PARTICULARS"
                                                Binding="{Binding Particulars}"
                                                Width="*"/>

                            <DataGridTextColumn Header="AMOUNT"
                                                Binding="{Binding Amount, StringFormat=N2}"
                                                ElementStyle="{StaticResource RightAlignedAmount}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>

            <!-- TARGET GRID -->

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="14">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="TARGET TRANSACTIONS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#183153"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="TargetGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="29">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="{Binding RowColor}"/>

                                <Style.Triggers>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                            Value="{Binding RowColor}"/>
                                        <Setter Property="Foreground"
                                            Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="DATE"
                                                Binding="{Binding TDate, StringFormat=dd-MMM}"
                                                Width="105"/>

                            <DataGridTextColumn Header="REF"
                                                Binding="{Binding Ref}"
                                                Width="95"/>

                            <DataGridTextColumn Header="PARTICULARS"
                                                Binding="{Binding Particulars}"
                                                Width="*"/>
                            <DataGridTextColumn Header="AMOUNT"
                                                Binding="{Binding Amount, StringFormat=N2}"
                                                ElementStyle="{StaticResource RightAlignedAmount}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>

        </Grid>

        <!-- SUMMARY -->

        <Border Grid.Row="5"
                Background="White"
                CornerRadius="10"
                Padding="14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ExactMatchesText"
                           Grid.Column="0"
                           Text="Exact Matches: 0"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="NearMatchesText"
                           Grid.Column="1"
                           Text="±2 Days: 0"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="UnmatchedText"
                           Grid.Column="2"
                           Text="Unmatched: 0"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="DifferenceText"
                           Grid.Column="3"
                           Text="Difference: 0.00"
                           FontWeight="SemiBold"
                           Foreground="#183153"
                           VerticalAlignment="Center"/>

                <Button x:Name="ReloadButton"
                        Grid.Column="4"
                        Content="RELOAD"
                        Width="120"
                        Height="38"
                        Background="#168A60"
                        Foreground="White"
                        FontWeight="SemiBold"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>