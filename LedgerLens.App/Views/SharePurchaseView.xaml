<UserControl x:Class="LedgerLens.App.Views.SharePurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <!-- DISCO - Share Purchase Heading -->
        <TextBlock Text="Share Purchase"
                   FontSize="26"
                   Grid.Row="0"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,20"/>

        <!-- ACCOUNTS -->
        <!-- ACCOUNTS -->
        <!-- DISCO - Account Information Panel -->
        <Border Background="#E4EAF2"
                Grid.Row="1"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="Account Information"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CREDIT ACCOUNT -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Credit Account (Broker)"/>
                        <ComboBox x:Name="CreditAccountCombo"
                      Height="30"
                      Margin="0,5,0,5"/>
                    </StackPanel>

                    <!-- SHARES ACCOUNT -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Shares Account"/>
                        <ComboBox x:Name="SharesAccountCombo"
                      Height="30"
                      Margin="0,5,0,5"/>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Border>
        <!-- TRANSACTION AND PURCHASE DETAILS -->
        <Grid Margin="0,0,0,15"
                  Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: TRANSACTION DETAILS -->
            <!-- DISCO - Transaction Details Panel -->
            <Border Grid.Column="0"
                    Background="#E4EAF2"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="Transaction Details"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#183153"
                           Margin="0,0,0,15"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- GL DATE -->
                        <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Foreground="#183153"
                               Text="GL Date"/>

                        <TextBox x:Name="GLDateTextBox"
                             Grid.Row="1"
                             VerticalContentAlignment="Center"
                             Grid.Column="0"
                             Height="30"
                             Margin="0,5,0,10"/>

                        <!-- REFERENCE -->
                        <TextBlock Grid.Row="0"
                       Grid.Column="2"
                            Foreground="#183153"
                            Text="Reference"/>

                        <TextBox x:Name="ReferenceTextBox"
                             Grid.Row="1"
                             Grid.Column="2"
                             VerticalContentAlignment="Center"
                             Height="30"
                             Margin="0,5,0,10"/>

                        <!-- PURCHASE DATE -->
                        <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Foreground="#183153"
                               Text="Purchase Date"/>

                        <TextBox x:Name="PurchaseDateTextBox"
                             Grid.Row="1"
                             Grid.Column="4"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Margin="0,5,0,10"/>

                        <!-- NARRATION -->
                        <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Foreground="#183153"
                               
                               Grid.ColumnSpan="5"
                               Text="Narration"/>

                        <TextBox x:Name="NarrationTextBox"
                             Grid.Row="3"
                             VerticalContentAlignment="Center"
                             Grid.Column="0"
                             Grid.ColumnSpan="5"
                             Height="30"
                             Margin="0,5,0,0"/>

                    </Grid>

                </StackPanel>
            </Border>

            <!-- RIGHT: PURCHASE DETAILS -->
            <!-- DISCO - Purchase Details Panel -->
            <Border Grid.Column="2"
                        Background="#E4EAF2"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">

                <StackPanel>

                    <TextBlock Text="Purchase Details"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#183153"
                           Margin="0,0,0,15"/>

                    <Grid VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- QUANTITY -->
                        <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Foreground="#183153"
                               Text="Quantity"/>

                        <TextBox x:Name="QuantityTextBox"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Height="30"
                                 TextAlignment="Right"
                                 VerticalContentAlignment="Center"
                                 TextChanged="PurchaseInputs_TextChanged"
                                 Margin="0,5,0,0"/>

                        <!-- PURCHASE RATE -->
                        <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Foreground="#183153"
                               Text="Purchase Rate"/>

                        <TextBox x:Name="PurchaseRateTextBox"
                             TextChanged="PurchaseInputs_TextChanged"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             Grid.Row="1"
                             Grid.Column="2"
                             Height="30"
                             Margin="0,5,0,0"/>

                        <!-- PURCHASE AMOUNT -->
                        <TextBlock Grid.Row="0"
                               Foreground="#183153"
                               Grid.Column="4"
                               Text="Purchase Amount"/>

                        <TextBox x:Name="PurchaseAmountTextBox"
                             Grid.Row="1"
                             Grid.Column="4"
                             Text="0.00"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Height="30"
                             Margin="0,5,0,0"/>

                        <!-- SAVE BUTTON -->
                        <Button x:Name="SaveButton"
                            Grid.Row="2"
                            Grid.Column="4"
                            Content="SAVE"
                            Height="34"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Stretch"
                            Background="#2878B5"
                            Foreground="White"
                            FontWeight="Bold"
                            IsEnabled="True"
                            Click="SaveButton_Click"/>

                    </Grid>

                </StackPanel>
            </Border>

        </Grid>

        <!-- COMPANY SELECTION -->
        <!-- DISCO - Company Selection Panel -->
        <Border Background="#E4EAF2"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Grid.Row="3"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,0,15">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Select Company"
                           FontSize="20"
                           Grid.Row="0"
                           FontWeight="SemiBold"
                           Foreground="#183153"
                           Margin="0,0,0,15"/>

                <DataGrid x:Name="CompaniesDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Background="#E4EAF2"
                          RowBackground="#E4EAF2"
                          AlternatingRowBackground="#EDF1F6"
                          AlternationCount="2"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#DCE4EF"
                          Foreground="#183153"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          RowHeight="30"
                          ColumnHeaderHeight="38">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Share ID"
                                            Binding="{Binding ShareId}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Company"
                                            Binding="{Binding CompanyName}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </Border>



    </Grid>


</UserControl>