<UserControl x:Class="LedgerLens.App.Views.CompaniesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6">
    <UserControl.Resources>

        <Style x:Key="DiscoButtonStyle"
           TargetType="Button">

            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#183153"/>
            <Setter Property="BorderBrush" Value="#B8C6D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="14,5"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.80"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.65"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>



            <Grid Grid.Column="0" Margin="0,0,18,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- your existing Companies content stays here -->
            <TextBlock Text="Companies"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,16"/>

            <!-- Ledger Account selector -->
           
            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,16">

                <TextBlock Text="Ledger Account"
               Foreground="#183153"
               VerticalAlignment="Center"
               Margin="0,0,12,0"/>

                <ComboBox Width="350"
              ItemsSource="{Binding ShareAccounts}"
              SelectedItem="{Binding SelectedLedgerAccount}"
              DisplayMemberPath="Account"/>

            </StackPanel>

            <!-- Search -->
            <TextBox Grid.Row="2"
         Height="36"
         Margin="0,0,0,14"
         Text="{Binding SearchText,
                        UpdateSourceTrigger=PropertyChanged}"
         FontSize="15"/>

            <!-- Companies belonging to selected account -->
            <DataGrid Grid.Row="3"
          ItemsSource="{Binding Companies}"
          SelectedItem="{Binding SelectedCompany,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#DCE4EF"
          Background="#E4EAF2"
          Foreground="#183153"
          RowBackground="#E4EAF2"
          AlternatingRowBackground="#EDF1F6"
          AlternationCount="2"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          FontFamily="Segoe UI"
          FontSize="14"
          RowHeight="34"
          ColumnHeaderHeight="38">

                <!-- DISCO COLUMN HEADERS -->

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EAF0F7"/>
                        <Setter Property="Foreground" Value="#183153"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderBrush" Value="#DCE4EF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- DISCO CELLS -->

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#183153"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCEBFA"/>
                                <Setter Property="Foreground" Value="#183153"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <!-- DISCO SELECTED ROW -->

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCEBFA"/>
                                <Setter Property="Foreground" Value="#183153"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- EXISTING BINDINGS PRESERVED -->

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                            Binding="{Binding ShareId}"
                            Width="90"/>

                    <DataGridTextColumn Header="COMPANY"
                            Binding="{Binding CompanyName}"
                            Width="*"/>

                </DataGrid.Columns>

            </DataGrid>


        </Grid>
        <!-- RIGHT: Editor -->
        <Border Grid.Column="1"
        Background="#E4EAF2"
        CornerRadius="12"
        BorderBrush="#CBD5E1"
        BorderThickness="1"
        Padding="22">

            <StackPanel>

                <TextBlock Text="Editor"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#183153"
                   Margin="0,0,0,20"/>

                <TextBlock Text="Share ID"
                   Foreground="#183153"/>

                <TextBox Text="{Binding EditingCompany.ShareId}"
                 IsReadOnly="True"
                 Margin="0,4,0,14"/>

                <TextBlock Text="Company Name"
                   Foreground="#183153"/>

                <TextBox Text="{Binding EditingCompany.CompanyName,
                                UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4,0,22"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="New"
                        Style="{StaticResource DiscoButtonStyle}"
                        Background="#D0E5FA"
                        Margin="0,0,10,0"
                        Click="New_Click"/>

                    <Button Content="Save"
                        Style="{StaticResource DiscoButtonStyle}"
                        Background="#C8EED8"
                        Margin="0,0,10,0"
                        Click="Save_Click"/>

                    <Button Content="Clear"
                        Style="{StaticResource DiscoButtonStyle}"
                        Background="#DCE2EA"/>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>