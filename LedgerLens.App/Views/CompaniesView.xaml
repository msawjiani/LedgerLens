<UserControl x:Class="LedgerLens.App.Views.CompaniesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>



            <Grid Grid.Column="0" Margin="0,0,18,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- your existing Companies content stays here -->
            <TextBlock Text="Companies"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,16"/>

            <!-- Ledger Account selector -->
           
            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,16">

                <TextBlock Text="Ledger Account"
               Foreground="#D1D5DB"
               VerticalAlignment="Center"
               Margin="0,0,12,0"/>

                <ComboBox Width="350"
              ItemsSource="{Binding ShareAccounts}"
              SelectedItem="{Binding SelectedLedgerAccount}"
              DisplayMemberPath="Account"/>

            </StackPanel>

            <!-- Search -->
            <TextBox Grid.Row="2"
         Height="36"
         Margin="0,0,0,14"
         Text="{Binding SearchText,
                        UpdateSourceTrigger=PropertyChanged}"
         FontSize="15"/>

            <!-- Companies belonging to selected account -->
            <DataGrid Grid.Row="3"
          ItemsSource="{Binding Companies}"
          SelectedItem="{Binding SelectedCompany,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                    Binding="{Binding ShareId}"
                                    Width="100"/>

                    <DataGridTextColumn Header="Company"
                                    Binding="{Binding CompanyName}"
                                    Width="*"/>

                </DataGrid.Columns>

            </DataGrid>


        </Grid>
        <!-- RIGHT: Editor -->
        <Border Grid.Column="1"
        Background="#1F2937"
        CornerRadius="10"
        Padding="22">

            <StackPanel>

                <TextBlock Text="Editor"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

                <TextBlock Text="Share ID"
                   Foreground="#D1D5DB"/>

                <TextBox Text="{Binding EditingCompany.ShareId}"
                 IsReadOnly="True"
                 Margin="0,4,0,14"/>

                <TextBlock Text="Company Name"
                   Foreground="#D1D5DB"/>

                <TextBox Text="{Binding EditingCompany.CompanyName,
                                UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4,0,22"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="New"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="New_Click"/>

                    <Button Content="Save"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="Save_Click"/>

                    <Button Content="Clear"
                    Width="80"/>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>